<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_radial_gradient"
    android:padding="0dp">

    <!-- 상단 네비게이션 바 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:background="#FF486C"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pactice Mode"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Score Box -->
    <FrameLayout
        android:id="@+id/score_box"
        android:layout_width="325dp"
        android:layout_height="237dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/score_box_shape"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_trophy_on"
                app:tint="#FFC107" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Final Score"
                android:textColor="#595085"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/average_score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="0.00"
                android:textColor="#3A2B5E"
                android:textSize="72sp"
                android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

    <!-- Buttons Layout -->
    <LinearLayout
        android:id="@+id/buttons_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/score_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Confirm Button -->
        <Button
            android:id="@+id/confirm_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="확인"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF486C"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="36dp"
            android:paddingRight="36dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="4dp"
            android:layout_marginEnd="16dp"/>

        <!-- Share Button -->
        <Button
            android:id="@+id/share_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="공유"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF7F98"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="36dp"
            android:paddingRight="36dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="4dp"/>
    </LinearLayout>

    <!-- 하단 네비게이션 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="#FF486C"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/btnOpenLeaderboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_trophy" />

        <ImageView
            android:id="@+id/btnMyPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_book" />

        
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>